@ATTRIBUTE 'job' {'admin.','blue-collar','entrepreneur','housemaid','management','retired','self-employed','services','student','technician','unemployed','unknown'}
@ATTRIBUTE 'marital' {'divorced','married','single'}
@ATTRIBUTE 'education' {'primary','secondary','tertiary','unknown'}
@ATTRIBUTE 'default' {'no','yes'}
@ATTRIBUTE 'housing' {'no','yes'}
